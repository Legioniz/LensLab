{
  "name": "lens-lab",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "description": "A local-first universal photography simulator and non-destructive Photo Lab with compact editing workspace and versioned shot recipes, persistent themes, synthesized interface sound, and guided interactions.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "demo": "npm run build && vite preview --host 127.0.0.1 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "verify": "npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
